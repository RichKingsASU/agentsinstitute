# Gate webhook batch through DispatchGuard: retries, out-of-order events, duplicate reservations.
# Render: python pipeline/generator.py ep03_drayage_dispatch
Set Shell "powershell"
Set Theme "Catppuccin Mocha"
Set FontFamily "JetBrains Mono"
Set FontSize 30
Set Width 1920
Set Height 1080
Set Padding 40
Set Framerate 30
Set PlaybackSpeed 1.0
Set TypingSpeed 40ms

Hide
Type "cls" Enter
Show

Sleep 500ms
Type "python demo_batch.py" Sleep 300ms Enter
Sleep 19s
